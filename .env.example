APP_NAME=Flutter Backend API
ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://app:replace-with-local-password@localhost:5432/app
# Generate a unique value with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
JWT_ISSUER=flutter-backend
JWT_AUDIENCE=flutter-client
# Comma-separated origins are parsed by pydantic-settings as JSON; use ["https://app.example.com"].
CORS_ORIGINS=[]
DOCS_ENABLED=true
# Link-token HMAC key; generate a unique value with: python -c "import secrets; print(secrets.token_urlsafe(48))"
ACCOUNT_LINK_TOKEN_SECRET=
PASSWORD_RESET_LINK_MINUTES=15
ACCOUNT_INVITATION_LINK_HOURS=24
ACCOUNT_ACTION_RESEND_SECONDS=60
# Mailtrap Email Sandbox: copy host, port, username, and password from its SMTP settings.
# Sandbox captures messages for testing; production delivery requires Mailtrap Email API/SMTP and a verified sender domain.
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USERNAME=
MAILTRAP_PASSWORD=
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME=Flutter Backend API
# Configure Flutter Universal Links / Android App Links on this HTTPS domain.
APP_LINK_BASE_URL=https://app.example.com
